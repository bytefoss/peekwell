<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window in the app's colours, so opening a screen never flashes the system's grey before Compose draws -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorAccent">@color/primary</item>
        <!-- the TV launcher's opening animation, in the app's night tone -->
        <item name="android:colorPrimary">@color/background</item>
        <!-- screens fade into each other instead of the TV's default, which jumps on many sets -->
        <item name="android:windowAnimationStyle">@style/ScreenFade</item>
    </style>

    <style name="ScreenFade" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/screen_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/screen_hold</item>
        <item name="android:activityCloseEnterAnimation">@anim/screen_hold</item>
        <item name="android:activityCloseExitAnimation">@anim/screen_exit</item>
    </style>
</resources>
